@let(pageTitle = 'Usuarios')
@include('partials/head')
@include('partials/page_start')

<section class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
  <div>
    <p class="text-sm font-bold text-slate-600">Directorio</p>
    <h2 class="text-2xl font-black">Usuarios registrados</h2>
  </div>
  @if(authUser.role.name === 'Administrador')
    <a href="/users/create" class="focus-ring inline-flex rounded-lg bg-[#18b98f] px-4 py-2.5 text-sm font-black text-white hover:bg-[#129b78]">Nuevo usuario</a>
  @endif
</section>

<form method="GET" action="/users" class="mb-5 grid gap-3 rounded-lg border border-emerald-100 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 md:grid-cols-[1fr_240px_auto]">
  <input name="search" value="{{ filters.search }}" class="focus-ring rounded-lg border border-emerald-200 px-3 py-2 text-sm dark:border-slate-700 dark:bg-[#7a1438]" placeholder="Nombre, email o numero..." />
  <select name="roleId" class="focus-ring rounded-lg border border-emerald-200 px-3 py-2 text-sm dark:border-slate-700 dark:bg-[#7a1438]">
    <option value="">Todos los roles</option>
    @each((role) in roles)
      <option value="{{ role.id }}" {{ String(role.id) === String(filters.roleId) ? 'selected' : '' }}>{{ role.name }}</option>
    @endeach
  </select>
  <button class="focus-ring rounded-lg bg-[#7a1438] px-4 py-2 text-sm font-black text-white dark:bg-white dark:text-slate-950">Filtrar</button>
</form>

<section class="rounded-lg border border-emerald-100 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[820px] text-left">
      <thead class="bg-[#f8fffb] text-xs font-black uppercase text-slate-600 dark:bg-[#7a1438] dark:text-slate-400">
        <tr>
          <th class="table-cell">Usuario</th>
          <th class="table-cell">Numero</th>
          <th class="table-cell">Rol</th>
          <th class="table-cell">Alta</th>
          <th class="table-cell text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        @each((userRecord) in users)
          <tr>
            <td class="table-cell">
              <p class="font-bold">{{ userRecord.fullName }}</p>
              <p class="text-xs text-slate-600">{{ userRecord.email }}</p>
            </td>
            <td class="table-cell font-bold">{{ userRecord.userNumber }}</td>
            <td class="table-cell"><span class="badge bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200">{{ userRecord.role.name }}</span></td>
            <td class="table-cell text-slate-600">{{ userRecord.createdAt.toFormat('dd/LL/yyyy') }}</td>
            <td class="table-cell">
              @if(authUser.role.name === 'Administrador')
                <div class="flex justify-end gap-2">
                  <a href="/users/{{ userRecord.id }}/edit" class="rounded-lg border border-emerald-200 px-3 py-2 text-sm font-bold dark:border-slate-700">Editar</a>
                  <form method="POST" action="/users/{{ userRecord.id }}?_method=DELETE">
                    {{ csrfField() }}
                    <input type="hidden" name="_method" value="DELETE" />
                    <button class="rounded-lg border border-rose-200 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-50 dark:border-rose-900">Eliminar</button>
                  </form>
                </div>
              @else
                <span class="block text-right text-sm text-slate-400">Consulta</span>
              @endif
            </td>
          </tr>
        @endeach
      </tbody>
    </table>
  </div>
</section>

<div class="mt-6 flex items-center justify-between rounded-lg border border-emerald-100 bg-white p-4 dark:border-slate-800 dark:bg-slate-950">
  <a href="{{ users.getPreviousPageUrl() || '#' }}" class="rounded-lg px-3 py-2 text-sm font-bold {{ users.getPreviousPageUrl() ? 'text-slate-800 hover:bg-emerald-50 dark:text-slate-200 dark:hover:bg-[#7a1438]' : 'pointer-events-none text-slate-400' }}">Anterior</a>
  <span class="text-sm font-bold text-slate-600">Pagina {{ users.currentPage }} de {{ users.lastPage }}</span>
  <a href="{{ users.getNextPageUrl() || '#' }}" class="rounded-lg px-3 py-2 text-sm font-bold {{ users.getNextPageUrl() ? 'text-slate-800 hover:bg-emerald-50 dark:text-slate-200 dark:hover:bg-[#7a1438]' : 'pointer-events-none text-slate-400' }}">Siguiente</a>
</div>

@include('partials/page_end')
