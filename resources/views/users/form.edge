@let(pageTitle = userRecord ? 'Editar usuario' : 'Nuevo usuario')
@include('partials/head')
@include('partials/page_start')

<section class="mx-auto max-w-3xl rounded-md border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-bold text-slate-500">Directorio</p>
      <h2 class="text-2xl font-black">{{ pageTitle }}</h2>
    </div>
    <a href="/users" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-bold dark:border-slate-700">Volver</a>
  </div>

  <form method="POST" action="{{ userRecord ? `/users/${userRecord.id}` : '/users' }}" class="grid gap-5 md:grid-cols-2">
    {{ csrfField() }}
    @if(userRecord)
      <input type="hidden" name="_method" value="PUT" />
    @endif

    <label class="block">
      <span class="text-sm font-bold">Numero</span>
      <input name="userNumber" value="{{ userRecord ? userRecord.userNumber : '' }}" required class="focus-ring mt-2 w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900" />
    </label>

    <label class="block">
      <span class="text-sm font-bold">Rol</span>
      <select name="roleId" required class="focus-ring mt-2 w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900">
        @each((role) in roles)
          <option value="{{ role.id }}" {{ userRecord && userRecord.roleId === role.id ? 'selected' : '' }}>{{ role.name }}</option>
        @endeach
      </select>
    </label>

    <label class="block md:col-span-2">
      <span class="text-sm font-bold">Nombre completo</span>
      <input name="fullName" value="{{ userRecord ? userRecord.fullName : '' }}" required class="focus-ring mt-2 w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900" />
    </label>

    <label class="block md:col-span-2">
      <span class="text-sm font-bold">Email</span>
      <input name="email" type="email" value="{{ userRecord ? userRecord.email : '' }}" required class="focus-ring mt-2 w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900" />
    </label>

    @if(!userRecord)
      <label class="block md:col-span-2">
        <span class="text-sm font-bold">Password</span>
        <input name="password" type="password" value="password123" required class="focus-ring mt-2 w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900" />
      </label>
    @endif

    <div class="md:col-span-2 flex justify-end gap-3">
      <a href="/users" class="rounded-md border border-slate-300 px-4 py-2.5 text-sm font-bold dark:border-slate-700">Cancelar</a>
      <button class="focus-ring rounded-md bg-teal-600 px-4 py-2.5 text-sm font-black text-white hover:bg-teal-700">Guardar</button>
    </div>
  </form>
</section>

@include('partials/page_end')
