@let(pageTitle = category ? 'Editar categoria' : 'Nueva categoria')
@include('partials/head')
@include('partials/page_start')

<section class="mx-auto max-w-2xl rounded-md border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-bold text-slate-500">Catalogo</p>
      <h2 class="text-2xl font-black">{{ pageTitle }}</h2>
    </div>
    <a href="/categories" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-bold dark:border-slate-700">Volver</a>
  </div>

  <form method="POST" action="{{ category ? `/categories/${category.id}` : '/categories' }}" class="space-y-5">
    {{ csrfField() }}
    @if(category)
      <input type="hidden" name="_method" value="PUT" />
    @endif
    <label class="block">
      <span class="text-sm font-bold">Nombre</span>
      <input name="name" value="{{ category ? category.name : '' }}" required class="focus-ring mt-2 w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900" />
    </label>
    <div class="flex justify-end gap-3">
      <a href="/categories" class="rounded-md border border-slate-300 px-4 py-2.5 text-sm font-bold dark:border-slate-700">Cancelar</a>
      <button class="focus-ring rounded-md bg-teal-600 px-4 py-2.5 text-sm font-black text-white hover:bg-teal-700">Guardar</button>
    </div>
  </form>
</section>

@include('partials/page_end')
