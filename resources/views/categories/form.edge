@let(pageTitle = category ? 'Editar categoria' : 'Nueva categoria')
@include('partials/head')
@include('partials/page_start')

<section class="mx-auto max-w-2xl rounded-lg border border-emerald-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-bold text-slate-600">Catalogo</p>
      <h2 class="text-2xl font-black">{{ pageTitle }}</h2>
    </div>
    <a href="/categories" class="rounded-lg border border-emerald-200 px-3 py-2 text-sm font-bold dark:border-slate-700">Volver</a>
  </div>

  <form method="POST" action="{{ category ? `/categories/${category.id}?_method=PUT` : '/categories' }}" class="space-y-5">
    {{ csrfField() }}
    @if(category)
      <input type="hidden" name="_method" value="PUT" />
    @endif
    <label class="block">
      <span class="text-sm font-bold">Nombre</span>
      <input name="name" value="{{ category ? category.name : '' }}" required class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]" />
    </label>
    <div class="flex justify-end gap-3">
      <a href="/categories" class="rounded-lg border border-emerald-200 px-4 py-2.5 text-sm font-bold dark:border-slate-700">Cancelar</a>
      <button class="focus-ring rounded-lg bg-[#18b98f] px-4 py-2.5 text-sm font-black text-white hover:bg-[#129b78]">Guardar</button>
    </div>
  </form>
</section>

@include('partials/page_end')
