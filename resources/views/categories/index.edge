@let(pageTitle = 'Categorias')
@include('partials/head')
@include('partials/page_start')

<section class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
  <div>
    <p class="text-sm font-bold text-slate-500">Catalogo</p>
    <h2 class="text-2xl font-black">Categorias</h2>
  </div>
  <a href="/categories/create" class="focus-ring inline-flex rounded-md bg-teal-600 px-4 py-2.5 text-sm font-black text-white hover:bg-teal-700">Nueva categoria</a>
</section>

<form method="GET" action="/categories" class="mb-5 flex gap-2 rounded-md border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <input name="search" value="{{ search }}" class="focus-ring min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" placeholder="Nombre" />
  <button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-black text-white dark:bg-white dark:text-slate-950">Buscar</button>
</form>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  @each((category) in categories)
    <article class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-black">{{ category.name }}</h3>
          <p class="mt-2 text-sm font-bold text-slate-500">{{ category.$extras.books_count || 0 }} libros</p>
        </div>
        <span class="badge bg-teal-50 text-teal-700 dark:bg-teal-500/15 dark:text-teal-200">Categoria</span>
      </div>
      <div class="mt-5 flex gap-2">
        <a href="/categories/{{ category.id }}/edit" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-bold dark:border-slate-700">Editar</a>
        <form method="POST" action="/categories/{{ category.id }}">
          {{ csrfField() }}
          <input type="hidden" name="_method" value="DELETE" />
          <button class="rounded-md border border-rose-200 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-50 dark:border-rose-900">Eliminar</button>
        </form>
      </div>
    </article>
  @endeach
</section>

<div class="mt-6 flex items-center justify-between rounded-md border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950">
  <a href="{{ categories.getPreviousPageUrl() || '#' }}" class="rounded-md px-3 py-2 text-sm font-bold {{ categories.getPreviousPageUrl() ? 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900' : 'pointer-events-none text-slate-400' }}">Anterior</a>
  <span class="text-sm font-bold text-slate-500">Pagina {{ categories.currentPage }} de {{ categories.lastPage }}</span>
  <a href="{{ categories.getNextPageUrl() || '#' }}" class="rounded-md px-3 py-2 text-sm font-bold {{ categories.getNextPageUrl() ? 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900' : 'pointer-events-none text-slate-400' }}">Siguiente</a>
</div>

@include('partials/page_end')
