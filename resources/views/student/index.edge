@let(pageTitle = 'Mi panel')
@include('partials/head')
@include('partials/page_start')

<section class="mb-6 grid gap-4 md:grid-cols-3">
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Prestamos activos</p>
    <p class="mt-2 text-3xl font-black">{{ loans.length }}</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Renovaciones maximas</p>
    <p class="mt-2 text-3xl font-black">2</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Extension</p>
    <p class="mt-2 text-3xl font-black">7 dias</p>
  </div>
</section>

<section class="rounded-md border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
    <h2 class="font-black">Libros en prestamo</h2>
  </div>
  <div class="divide-y divide-slate-100 dark:divide-slate-800">
    @each((loan) in loans)
      <div class="grid gap-4 px-5 py-4 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="font-black">{{ loan.book.title }}</p>
          <p class="text-sm text-slate-500">Prestamo: {{ loan.loanDate.toFormat('dd/LL/yyyy') }} - Vence: {{ loan.dueDate.toFormat('dd/LL/yyyy') }}</p>
          <p class="mt-1 text-sm font-bold {{ loan.status === 'OVERDUE' ? 'text-rose-600' : 'text-emerald-600' }}">
            @if(loan.status === 'OVERDUE')
              Vencido
            @else
              {{ loan.daysRemaining }} dias restantes
            @endif
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge bg-blue-50 text-blue-700 dark:bg-blue-500/15 dark:text-blue-200">{{ loan.renewalsAvailable }} renovaciones</span>
          <form method="POST" action="/student/loans/{{ loan.id }}/renew">
            {{ csrfField() }}
            <button class="rounded-md bg-teal-600 px-3 py-2 text-sm font-black text-white hover:bg-teal-700 disabled:opacity-50" {{ loan.renewalsAvailable <= 0 || loan.status === 'OVERDUE' ? 'disabled' : '' }}>Renovar</button>
          </form>
        </div>
      </div>
    @endeach
    @if(loans.length === 0)
      <div class="px-5 py-8 text-center text-sm font-bold text-slate-500">No tienes prestamos activos.</div>
    @endif
  </div>
</section>

<section class="mt-6">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="font-black">Recomendaciones</h2>
    <a href="/student/recommendations" class="text-sm font-bold text-teal-700 dark:text-teal-300">Ver todas</a>
  </div>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    @each((book) in recommendations)
      <article class="rounded-md border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <img src="{{ book.coverImage || '/images/covers/cover-1.svg' }}" alt="" class="mb-4 h-40 w-full rounded-md object-cover" />
        <h3 class="font-black">{{ book.title }}</h3>
        <p class="mt-1 text-sm text-slate-500">{{ book.author }}</p>
        <form method="POST" action="/student/books/{{ book.id }}/request" class="mt-4">
          {{ csrfField() }}
          <button class="w-full rounded-md bg-teal-600 px-3 py-2 text-sm font-black text-white hover:bg-teal-700">Solicitar</button>
        </form>
      </article>
    @endeach
  </div>
</section>

@include('partials/page_end')
