@let(pageTitle = 'Mi panel')
@include('partials/head')
@include('partials/page_start')

<section class="mb-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  <div class="rounded-lg border border-emerald-100 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-600">Prestamos activos</p>
    <p class="mt-2 text-3xl font-black">{{ loans.length }}</p>
  </div>
  <div class="rounded-lg border border-emerald-100 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-600">Renovacion maxima</p>
    <p class="mt-2 text-3xl font-black">1</p>
  </div>
  <div class="rounded-lg border border-emerald-100 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-600">Extension</p>
    <p class="mt-2 text-3xl font-black">7 dias</p>
  </div>
  <div class="rounded-lg border {{ activeFineTotal > 0 ? 'border-rose-200 bg-rose-50' : 'border-emerald-100 bg-white' }} p-5 shadow-sm">
    <p class="text-sm font-bold text-slate-600">Multa pendiente</p>
    <p class="mt-2 text-3xl font-black {{ activeFineTotal > 0 ? 'text-[#7a1438]' : 'text-emerald-700' }}">${{ activeFineTotal }}</p>
    <a href="#multas" class="mt-3 inline-flex rounded-lg px-3 py-2 text-xs font-black {{ activeFineTotal > 0 ? 'animate-pulse bg-[#7a1438] text-white shadow-lg shadow-[#7a1438]/20' : 'bg-emerald-50 text-emerald-700' }}">
      {{ activeFineTotal > 0 ? 'Revisar multas' : 'Sin adeudos' }}
    </a>
  </div>
</section>

<section class="rounded-lg border border-emerald-100 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="border-b border-emerald-100 px-5 py-4 dark:border-slate-800">
    <h2 class="font-black">Libros en prestamo</h2>
  </div>
  <div class="divide-y divide-slate-100 dark:divide-slate-800">
    @each((loan) in loans)
      <div class="grid gap-4 px-5 py-4 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="font-black">{{ loan.book.title }}</p>
          <p class="text-sm text-slate-600">Prestamo: {{ loan.loanDate.toFormat('dd/LL/yyyy') }} - Vence: {{ loan.dueDate.toFormat('dd/LL/yyyy') }}</p>
          <p class="mt-1 text-sm font-bold {{ loan.status === 'OVERDUE' ? 'text-rose-600' : 'text-emerald-600' }}">
            @if(loan.status === 'OVERDUE')
              Vencido
            @else
              {{ loan.daysRemaining }} dias restantes
            @endif
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge bg-blue-50 text-blue-700 dark:bg-blue-500/15 dark:text-blue-200">{{ loan.renewalsAvailable }} renovacion</span>
          <form method="POST" action="/student/loans/{{ loan.id }}/renew">
            {{ csrfField() }}
            <button class="rounded-lg bg-[#18b98f] px-3 py-2 text-sm font-black text-white hover:bg-[#129b78] disabled:opacity-50" {{ loan.renewalsAvailable <= 0 || loan.status === 'OVERDUE' ? 'disabled' : '' }}>Renovar</button>
          </form>
        </div>
      </div>
    @endeach
    @if(loans.length === 0)
      <div class="px-5 py-8 text-center text-sm font-bold text-slate-600">No tienes prestamos activos.</div>
    @endif
  </div>
</section>

<section id="multas" class="mt-6 grid gap-6 xl:grid-cols-[0.85fr_1.15fr]">
  <div class="rounded-lg border {{ activeFineTotal > 0 ? 'border-rose-200 bg-rose-50' : 'border-emerald-100 bg-white' }} p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Multas</p>
        <h2 class="font-black">Atrasos de biblioteca</h2>
      </div>
      <span class="badge {{ activeFineTotal > 0 ? 'bg-[#7a1438] text-white' : 'bg-emerald-50 text-emerald-700' }}">
        ${{ finePerLateDay }} por dia
      </span>
    </div>

    <div class="mt-5 rounded-lg bg-white p-4 shadow-sm">
      <p class="text-sm font-bold text-slate-600">Pendiente actual</p>
      <p class="mt-1 text-4xl font-black {{ activeFineTotal > 0 ? 'text-[#7a1438]' : 'text-emerald-700' }}">${{ activeFineTotal }}</p>
      <p class="mt-2 text-sm font-semibold text-slate-600">Total generado en historial: ${{ fineTotal }}</p>
    </div>

    @if(activeFineTotal > 0)
      <a href="/student/history" class="mt-4 inline-flex animate-pulse rounded-lg bg-[#7a1438] px-4 py-3 text-sm font-black text-white shadow-lg shadow-[#7a1438]/25">
        Ver historial de multas
      </a>
    @else
      <p class="mt-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700">No tienes multas pendientes.</p>
    @endif
  </div>

  <div class="rounded-lg border border-emerald-100 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Detalle</p>
        <h2 class="font-black">Multas por libro</h2>
      </div>
      <span class="badge bg-[#fff1f6] text-[#7a1438]">Pesos MXN</span>
    </div>
    @if(fineLoans.length > 0)
      <div class="h-72">
        <canvas data-chart="{{ fineChart }}" data-chart-type="bar" data-chart-label="Multa"></canvas>
      </div>
      <div class="mt-4 divide-y divide-slate-100">
        @each((loan) in fineLoans.slice(0, 5))
          <div class="flex items-center justify-between gap-4 py-3">
            <div>
              <p class="font-black">{{ loan.book.title }}</p>
              <p class="text-sm font-semibold text-slate-600">{{ loan.daysLate }} dias tarde</p>
            </div>
            <span class="rounded-lg bg-[#7a1438] px-3 py-2 text-sm font-black text-white">${{ loan.fineAmount }}</span>
          </div>
        @endeach
      </div>
    @else
      <div class="grid h-72 place-items-center rounded-lg bg-emerald-50 text-center">
        <div>
          <p class="text-3xl font-black text-emerald-700">$0</p>
          <p class="mt-2 text-sm font-black text-slate-600">Sin multas registradas</p>
        </div>
      </div>
    @endif
  </div>
</section>

<section class="mt-6">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="font-black">Recomendaciones</h2>
    <a href="/student/recommendations" class="text-sm font-bold text-emerald-700 dark:text-emerald-300">Ver todas</a>
  </div>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    @each((book) in recommendations)
      <article class="rounded-lg border border-emerald-100 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
        <img src="{{ book.coverImage || '/images/covers/cover-1.svg' }}" alt="" onerror="this.onerror=null;this.src='/images/covers/cover-1.svg'" class="mb-4 h-40 w-full rounded-lg object-cover" />
        <h3 class="font-black">{{ book.title }}</h3>
        <p class="mt-1 text-sm text-slate-600">{{ book.author }}</p>
        <form method="POST" action="/student/books/{{ book.id }}/request" class="mt-4">
          {{ csrfField() }}
          <button class="w-full rounded-lg bg-[#18b98f] px-3 py-2 text-sm font-black text-white hover:bg-[#129b78]">Solicitar</button>
        </form>
      </article>
    @endeach
  </div>
</section>

@include('partials/page_end')
