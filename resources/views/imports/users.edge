@let(pageTitle = 'Importar cuentas')
@include('partials/head')
@include('partials/page_start')

<section class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
  <div>
    <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Carga masiva</p>
    <h2 class="text-3xl font-black">Importar usuarios desde Excel</h2>
    <p class="mt-2 max-w-3xl text-sm font-semibold text-slate-600">
      Vista demostrativa para crear cuentas a partir de un concentrado escolar con matriculas, docentes, grupos y datos academicos.
    </p>
  </div>
  <span class="rounded-lg bg-[#fff1f6] px-4 py-3 text-sm font-black text-[#7a1438]">Demo visual</span>
</section>

<section class="grid gap-6 xl:grid-cols-[0.9fr_1.1fr]">
  <div class="rounded-lg border border-emerald-100 bg-white p-6 shadow-sm">
    <div class="mb-5 flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Archivo</p>
        <h3 class="text-xl font-black">Seleccionar concentrado</h3>
      </div>
      <span class="badge bg-emerald-50 text-emerald-700">.xlsx / .csv</span>
    </div>

    <label class="block rounded-lg border-2 border-dashed border-emerald-200 bg-emerald-50/70 p-6 text-center">
      <input type="file" accept=".xlsx,.xls,.csv" class="hidden" />
      <span class="mx-auto grid h-14 w-14 place-items-center rounded-lg bg-[#7a1438] text-xl font-black text-white">X</span>
      <span class="mt-4 block text-lg font-black text-slate-950">Arrastra o selecciona un archivo Excel</span>
      <span class="mt-2 block text-sm font-semibold text-slate-600">Ejemplo: concentrado_alumnos_utt_2026.xlsx</span>
    </label>

    <div class="mt-5 rounded-lg bg-white p-4 shadow-sm">
      <p class="text-sm font-black text-slate-950">Regla de contrasenas automaticas</p>
      <p class="mt-2 text-sm font-semibold text-slate-600">
        Para alumnos se propone generar <strong>UTT-matricula</strong>. Para docentes se propone <strong>UTT-claveDocente</strong>.
      </p>
      <div class="mt-3 grid gap-2 text-sm font-bold sm:grid-cols-2">
        <span class="rounded-lg bg-emerald-50 px-3 py-2 text-emerald-700">23170051 -> UTT-23170051</span>
        <span class="rounded-lg bg-[#fff1f6] px-3 py-2 text-[#7a1438]">DOC-0041 -> UTT-DOC0041</span>
      </div>
    </div>
  </div>

  <div class="rounded-lg border border-emerald-100 bg-white p-6 shadow-sm">
    <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Columnas requeridas</p>
    <h3 class="mt-1 text-xl font-black">Formato sugerido del Excel</h3>

    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-emerald-100 bg-emerald-50 p-4">
        <p class="font-black text-slate-950">Datos principales</p>
        <ul class="mt-3 space-y-2 text-sm font-semibold text-slate-700">
          <li>matricula</li>
          <li>nombre_completo</li>
          <li>correo_institucional</li>
          <li>tipo_usuario: Alumno o Docente</li>
        </ul>
      </div>
      <div class="rounded-lg border border-emerald-100 bg-[#fff7fa] p-4">
        <p class="font-black text-slate-950">Datos academicos</p>
        <ul class="mt-3 space-y-2 text-sm font-semibold text-slate-700">
          <li>carrera_o_area</li>
          <li>grupo</li>
          <li>cuatrimestre</li>
          <li>turno</li>
        </ul>
      </div>
    </div>

    <div class="mt-5 rounded-lg border border-emerald-100 bg-white p-4 shadow-sm">
      <p class="font-black text-slate-950">Validaciones simuladas</p>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg bg-emerald-50 p-3">
          <p class="text-2xl font-black text-emerald-700">128</p>
          <p class="text-xs font-bold text-slate-600">Filas validas</p>
        </div>
        <div class="rounded-lg bg-[#fff1f6] p-3">
          <p class="text-2xl font-black text-[#7a1438]">4</p>
          <p class="text-xs font-bold text-slate-600">Duplicados</p>
        </div>
        <div class="rounded-lg bg-emerald-50 p-3">
          <p class="text-2xl font-black text-emerald-700">132</p>
          <p class="text-xs font-bold text-slate-600">Total leidas</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="mt-6 rounded-lg border border-emerald-100 bg-white shadow-sm"
  x-data="{
    modalOpen: false,
    editUser: {
      userNumber: '',
      fullName: '',
      email: '',
      role: 'Alumno',
      program: '',
      group: '',
      password: '',
      status: 'Listo'
    }
  }"
>
  <div class="flex flex-col gap-3 border-b border-emerald-100 px-5 py-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Previsualizacion</p>
      <h3 class="text-xl font-black">Cuentas que se generarian</h3>
    </div>
    <button class="rounded-lg bg-[#18b98f] px-4 py-3 text-sm font-black text-white shadow-lg shadow-emerald-500/20">
      Simular importacion
    </button>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[1100px] text-left">
      <thead class="bg-[#f8fffb] text-xs font-black uppercase text-slate-600">
        <tr>
          <th class="table-cell">Matricula / clave</th>
          <th class="table-cell">Nombre</th>
          <th class="table-cell">Correo</th>
          <th class="table-cell">Tipo</th>
          <th class="table-cell">Carrera / area</th>
          <th class="table-cell">Grupo</th>
          <th class="table-cell">Password generado</th>
          <th class="table-cell">Estado</th>
          <th class="table-cell text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        @each((row) in sampleRows)
          <tr>
            <td class="table-cell font-black">{{ row.userNumber }}</td>
            <td class="table-cell">
              <p class="font-bold">{{ row.fullName }}</p>
              <p class="text-xs font-semibold text-slate-600">{{ row.role === 'Alumno' ? 'Cuenta estudiantil' : 'Cuenta docente' }}</p>
            </td>
            <td class="table-cell text-slate-700">{{ row.email }}</td>
            <td class="table-cell">
              <span class="badge {{ row.role === 'Alumno' ? 'bg-emerald-50 text-emerald-700' : 'bg-[#fff1f6] text-[#7a1438]' }}">{{ row.role }}</span>
            </td>
            <td class="table-cell">{{ row.program }}</td>
            <td class="table-cell font-bold">{{ row.group }}</td>
            <td class="table-cell">
              <span class="rounded-lg bg-slate-100 px-3 py-2 font-mono text-sm font-black text-slate-800">{{ row.password }}</span>
            </td>
            <td class="table-cell">
              <span class="badge {{ row.status === 'Listo' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' }}">{{ row.status }}</span>
            </td>
            <td class="table-cell text-right">
              <button
                class="rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm font-black text-[#7a1438] hover:bg-emerald-50"
                @click="modalOpen = true; editUser = {
                  userNumber: '{{ row.userNumber }}',
                  fullName: '{{ row.fullName }}',
                  email: '{{ row.email }}',
                  role: '{{ row.role }}',
                  program: '{{ row.program }}',
                  group: '{{ row.group }}',
                  password: '{{ row.password }}',
                  status: '{{ row.status }}'
                }"
              >
                Editar
              </button>
            </td>
          </tr>
        @endeach
      </tbody>
    </table>
  </div>

  <div
    x-cloak
    x-show="modalOpen"
    class="fixed inset-0 z-50 grid place-items-center bg-slate-950/45 px-4"
    @keydown.escape.window="modalOpen = false"
  >
    <div class="w-full max-w-3xl rounded-lg border border-emerald-100 bg-white shadow-2xl" @click.outside="modalOpen = false">
      <div class="flex items-start justify-between gap-4 border-b border-emerald-100 px-6 py-5">
        <div>
          <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Edicion previa</p>
          <h3 class="text-2xl font-black">Editar usuario importado</h3>
          <p class="mt-1 text-sm font-semibold text-slate-600">Demo visual para corregir datos antes de crear la cuenta.</p>
        </div>
        <button class="rounded-lg bg-emerald-50 px-3 py-2 text-sm font-black text-slate-700" @click="modalOpen = false">Cerrar</button>
      </div>

      <div class="grid gap-5 p-6 md:grid-cols-2">
        <label class="block">
          <span class="text-sm font-black text-slate-700">Matricula / clave</span>
          <input x-model="editUser.userNumber" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-black text-slate-700">Tipo de usuario</span>
          <select x-model="editUser.role" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm">
            <option>Alumno</option>
            <option>Docente</option>
            <option>Empleado</option>
          </select>
        </label>

        <label class="block md:col-span-2">
          <span class="text-sm font-black text-slate-700">Nombre completo</span>
          <input x-model="editUser.fullName" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm" />
        </label>

        <label class="block md:col-span-2">
          <span class="text-sm font-black text-slate-700">Correo institucional</span>
          <input x-model="editUser.email" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-black text-slate-700">Carrera o area</span>
          <input x-model="editUser.program" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-black text-slate-700">Grupo</span>
          <input x-model="editUser.group" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-black text-slate-700">Password generado</span>
          <input x-model="editUser.password" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 font-mono text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-black text-slate-700">Estado</span>
          <select x-model="editUser.status" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm">
            <option>Listo</option>
            <option>Duplicado</option>
            <option>Revisar</option>
          </select>
        </label>
      </div>

      <div class="flex flex-col gap-3 border-t border-emerald-100 bg-[#f8fffb] px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-semibold text-slate-600">
          Estos cambios son una simulacion visual; servirian para revisar la fila antes de importarla.
        </p>
        <button class="rounded-lg bg-[#18b98f] px-4 py-3 text-sm font-black text-white shadow-lg shadow-emerald-500/20" @click="modalOpen = false">
          Guardar cambios
        </button>
      </div>
    </div>
  </div>
</section>

@include('partials/page_end')
