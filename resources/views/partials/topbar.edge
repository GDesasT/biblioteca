<header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-emerald-100 bg-white/85 px-4 backdrop-blur lg:px-8">
  <button class="focus-ring rounded-lg border border-emerald-100 bg-white px-3 py-2 text-sm font-bold text-[#7a1438] lg:hidden" @click="sidebarOpen = true">
    Menu
  </button>
  <div>
    <p class="text-xs font-black uppercase tracking-wide text-[#7a1438]">Universidad Tecnologica de Torreon</p>
    <h1 class="text-xl font-black text-slate-950">{{ pageTitle }}</h1>
  </div>
  <div class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-sm font-black text-emerald-700 sm:block">Biblioteca Coyote</div>
</header>
