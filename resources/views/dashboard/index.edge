@let(pageTitle = 'Dashboard')
@include('partials/head')
@include('partials/page_start')

<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Libros</p>
    <p class="mt-3 text-3xl font-black">{{ stats.books }}</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Disponibles</p>
    <p class="mt-3 text-3xl font-black text-emerald-600">{{ stats.availableUnits }}</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Prestados</p>
    <p class="mt-3 text-3xl font-black text-blue-600">{{ stats.loanedUnits }}</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Vencidos</p>
    <p class="mt-3 text-3xl font-black text-rose-600">{{ stats.overdueLoans }}</p>
  </div>
</section>

<section class="mt-6 grid gap-4 lg:grid-cols-3">
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Usuarios registrados</p>
    <p class="mt-3 text-4xl font-black">{{ stats.users }}</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Prestamos activos</p>
    <p class="mt-3 text-4xl font-black">{{ stats.activeLoans }}</p>
  </div>
  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <p class="text-sm font-bold text-slate-500">Unidades totales</p>
    <p class="mt-3 text-4xl font-black">{{ stats.totalUnits }}</p>
  </div>
</section>

<section class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="rounded-md border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
      <h2 class="font-black">Libros mas prestados</h2>
    </div>
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      @each((book, index) in topBooks)
        <div class="flex items-center justify-between px-5 py-4">
          <div>
            <p class="font-bold">{{ book.title }}</p>
            <p class="text-sm text-slate-500">{{ book.author }}</p>
          </div>
          <span class="badge bg-blue-50 text-blue-700 dark:bg-blue-500/15 dark:text-blue-200">{{ book.total }}</span>
        </div>
      @endeach
    </div>
  </div>

  <div class="rounded-md border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
    <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
      <h2 class="font-black">Categorias populares</h2>
    </div>
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      @each((category) in popularCategories)
        <div class="flex items-center justify-between px-5 py-4">
          <p class="font-bold">{{ category.name }}</p>
          <span class="badge bg-teal-50 text-teal-700 dark:bg-teal-500/15 dark:text-teal-200">{{ category.total }}</span>
        </div>
      @endeach
    </div>
  </div>
</section>

@include('partials/page_end')
