@let(pageTitle = 'Editar prestamo')
@include('partials/head')
@include('partials/page_start')

<section class="mx-auto max-w-3xl rounded-lg border border-emerald-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-bold text-slate-600">{{ loan.user.fullName }}</p>
      <h2 class="text-2xl font-black">{{ loan.book.title }}</h2>
    </div>
    <a href="/loans" class="rounded-lg border border-emerald-200 px-3 py-2 text-sm font-bold dark:border-slate-700">Volver</a>
  </div>

  <form method="POST" action="/loans/{{ loan.id }}?_method=PUT" class="grid gap-5 md:grid-cols-2">
    {{ csrfField() }}
    <input type="hidden" name="_method" value="PUT" />

    <label class="block">
      <span class="text-sm font-bold">Fecha de vencimiento</span>
      <input name="dueDate" type="date" value="{{ loan.dueDate.toISODate() }}" required class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]" />
    </label>

    <label class="block">
      <span class="text-sm font-bold">Estado</span>
      <select name="status" required class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]">
        <option value="ACTIVE" {{ loan.status === 'ACTIVE' ? 'selected' : '' }}>ACTIVE</option>
        <option value="RENEWED" {{ loan.status === 'RENEWED' ? 'selected' : '' }}>RENEWED</option>
        <option value="RETURNED" {{ loan.status === 'RETURNED' ? 'selected' : '' }}>RETURNED</option>
        <option value="OVERDUE" {{ loan.status === 'OVERDUE' ? 'selected' : '' }}>OVERDUE</option>
      </select>
    </label>

    <label class="block">
      <span class="text-sm font-bold">Renovaciones</span>
      <input name="renewalCount" type="number" min="0" max="1" value="{{ loan.renewalCount }}" required class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]" />
    </label>

    <div class="md:col-span-2 flex justify-end gap-3">
      <a href="/loans" class="rounded-lg border border-emerald-200 px-4 py-2.5 text-sm font-bold dark:border-slate-700">Cancelar</a>
      <button class="focus-ring rounded-lg bg-[#18b98f] px-4 py-2.5 text-sm font-black text-white hover:bg-[#129b78]">Guardar</button>
    </div>
  </form>
</section>

@include('partials/page_end')
