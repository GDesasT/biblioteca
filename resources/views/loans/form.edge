@let(pageTitle = 'Registrar prestamo')
@include('partials/head')
@include('partials/page_start')

<section class="mx-auto max-w-3xl rounded-lg border border-emerald-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-bold text-slate-600">Circulacion</p>
      <h2 class="text-2xl font-black">{{ pageTitle }}</h2>
    </div>
    <a href="/loans" class="rounded-lg border border-emerald-200 px-3 py-2 text-sm font-bold dark:border-slate-700">Volver</a>
  </div>

  <form method="POST" action="/loans" class="grid gap-5 md:grid-cols-2">
    {{ csrfField() }}
    <label class="block md:col-span-2">
      <span class="text-sm font-bold">Usuario estudiante</span>
      <select name="userId" required class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]">
        @each((userRecord) in users)
          <option value="{{ userRecord.id }}">{{ userRecord.fullName }} - {{ userRecord.userNumber }}</option>
        @endeach
      </select>
    </label>

    <label class="block md:col-span-2">
      <span class="text-sm font-bold">Libro disponible</span>
      <select name="bookId" required class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]">
        @each((book) in books)
          <option value="{{ book.id }}">{{ book.title }} - {{ book.availableUnits }} disponibles</option>
        @endeach
      </select>
    </label>

    <label class="block">
      <span class="text-sm font-bold">Dias</span>
      <input name="days" type="number" min="1" max="60" value="14" class="focus-ring mt-2 w-full rounded-lg border border-emerald-200 px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-[#7a1438]" />
    </label>

    <div class="md:col-span-2 flex justify-end gap-3">
      <a href="/loans" class="rounded-lg border border-emerald-200 px-4 py-2.5 text-sm font-bold dark:border-slate-700">Cancelar</a>
      <button class="focus-ring rounded-lg bg-[#18b98f] px-4 py-2.5 text-sm font-black text-white hover:bg-[#129b78]">Guardar</button>
    </div>
  </form>
</section>

@include('partials/page_end')
