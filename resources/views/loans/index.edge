@let(pageTitle = 'Prestamos')
@include('partials/head')
@include('partials/page_start')

<section class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
  <div>
    <p class="text-sm font-bold text-slate-500">Circulacion</p>
    <h2 class="text-2xl font-black">Prestamos</h2>
  </div>
  <a href="/loans/create" class="focus-ring inline-flex rounded-md bg-teal-600 px-4 py-2.5 text-sm font-black text-white hover:bg-teal-700">Registrar prestamo</a>
</section>

<form method="GET" action="/loans" class="mb-5 grid gap-3 rounded-md border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 md:grid-cols-[1fr_220px_auto]">
  <input name="search" value="{{ filters.search }}" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" placeholder="Usuario, numero, libro o ISBN..." />
  <select name="status" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
    <option value="">Todos los estados</option>
    <option value="ACTIVE" {{ filters.status === 'ACTIVE' ? 'selected' : '' }}>Activo</option>
    <option value="RENEWED" {{ filters.status === 'RENEWED' ? 'selected' : '' }}>Renovado</option>
    <option value="RETURNED" {{ filters.status === 'RETURNED' ? 'selected' : '' }}>Devuelto</option>
    <option value="OVERDUE" {{ filters.status === 'OVERDUE' ? 'selected' : '' }}>Vencido</option>
  </select>
  <button class="focus-ring rounded-md bg-slate-900 px-4 py-2 text-sm font-black text-white dark:bg-white dark:text-slate-950">Filtrar</button>
</form>

<section class="rounded-md border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-950">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[980px] text-left">
      <thead class="bg-slate-50 text-xs font-black uppercase text-slate-500 dark:bg-slate-900 dark:text-slate-400">
        <tr>
          <th class="table-cell">Usuario</th>
          <th class="table-cell">Libro</th>
          <th class="table-cell">Fechas</th>
          <th class="table-cell">Renovaciones</th>
          <th class="table-cell">Estado</th>
          <th class="table-cell text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        @each((loan) in loans)
          <tr>
            <td class="table-cell">
              <p class="font-bold">{{ loan.user.fullName }}</p>
              <p class="text-xs text-slate-500">{{ loan.user.userNumber }}</p>
            </td>
            <td class="table-cell">
              <p class="font-bold">{{ loan.book.title }}</p>
              <p class="text-xs text-slate-500">{{ loan.book.isbn }}</p>
            </td>
            <td class="table-cell">
              <p class="text-sm">Prestamo: {{ loan.loanDate.toFormat('dd/LL/yyyy') }}</p>
              <p class="text-sm">Vence: {{ loan.dueDate.toFormat('dd/LL/yyyy') }}</p>
              @if(loan.returnedAt)
                <p class="text-sm text-emerald-600">Devuelto: {{ loan.returnedAt.toFormat('dd/LL/yyyy') }}</p>
              @endif
            </td>
            <td class="table-cell font-bold">{{ loan.renewalCount }} / 2</td>
            <td class="table-cell">
              <span class="badge {{ loan.status === 'OVERDUE' ? 'bg-rose-50 text-rose-700' : loan.status === 'RETURNED' ? 'bg-emerald-50 text-emerald-700' : 'bg-blue-50 text-blue-700' }}">{{ loan.status }}</span>
            </td>
            <td class="table-cell">
              <div class="flex justify-end gap-2">
                <a href="/loans/{{ loan.id }}/edit" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-bold dark:border-slate-700">Editar</a>
                @if(loan.status !== 'RETURNED')
                  <form method="POST" action="/loans/{{ loan.id }}/return">
                    {{ csrfField() }}
                    <button class="rounded-md bg-emerald-600 px-3 py-2 text-sm font-bold text-white hover:bg-emerald-700">Devolver</button>
                  </form>
                  <form method="POST" action="/loans/{{ loan.id }}/renew">
                    {{ csrfField() }}
                    <button class="rounded-md border border-blue-200 px-3 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50" {{ loan.renewalCount >= 2 || loan.status === 'OVERDUE' ? 'disabled' : '' }}>Renovar</button>
                  </form>
                @endif
                @if(authUser.role.name === 'Administrador' && loan.status === 'RETURNED')
                  <form method="POST" action="/loans/{{ loan.id }}">
                    {{ csrfField() }}
                    <input type="hidden" name="_method" value="DELETE" />
                    <button class="rounded-md border border-rose-200 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-50">Eliminar</button>
                  </form>
                @endif
              </div>
            </td>
          </tr>
        @endeach
      </tbody>
    </table>
  </div>
</section>

<div class="mt-6 flex items-center justify-between rounded-md border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950">
  <a href="{{ loans.getPreviousPageUrl() || '#' }}" class="rounded-md px-3 py-2 text-sm font-bold {{ loans.getPreviousPageUrl() ? 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900' : 'pointer-events-none text-slate-400' }}">Anterior</a>
  <span class="text-sm font-bold text-slate-500">Pagina {{ loans.currentPage }} de {{ loans.lastPage }}</span>
  <a href="{{ loans.getNextPageUrl() || '#' }}" class="rounded-md px-3 py-2 text-sm font-bold {{ loans.getNextPageUrl() ? 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900' : 'pointer-events-none text-slate-400' }}">Siguiente</a>
</div>

@include('partials/page_end')
