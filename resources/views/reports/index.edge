</section>

<section class="mt-6 rounded-lg border border-emerald-100 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-start justify-between gap-3">
    <div>
      <p class="text-sm font-black uppercase tracking-wide text-[#7a1438]">Ranking</p>
      <h2 class="font-black">Top libros mas usados</h2>
    </div>
    <span class="badge bg-emerald-50 text-emerald-700">Top 10</span>
  </div>
