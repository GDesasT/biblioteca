@let(pageTitle = 'Libros')
@include('partials/head')
@include('partials/page_start')

<section class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
  <div>
    <p class="text-sm font-bold text-slate-500">Catalogo</p>
    <h2 class="text-2xl font-black">Libros registrados</h2>
  </div>
  @if(authUser.role.name !== 'Estudiante')
    <a href="/books/create" class="focus-ring inline-flex rounded-md bg-teal-600 px-4 py-2.5 text-sm font-black text-white hover:bg-teal-700">Nuevo libro</a>
  @endif
</section>

<form method="GET" action="/books" class="mb-5 grid gap-3 rounded-md border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 md:grid-cols-5">
  <input name="search" value="{{ filters.search }}" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" placeholder="Titulo, autor, ISBN..." />
  <select name="categoryId" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
    <option value="">Todas las categorias</option>
    @each((category) in categories)
      <option value="{{ category.id }}" {{ String(category.id) === String(filters.categoryId) ? 'selected' : '' }}>{{ category.name }}</option>
    @endeach
  </select>
  <select name="publisherId" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
    <option value="">Todas las editoriales</option>
    @each((publisher) in publishers)
      <option value="{{ publisher.id }}" {{ String(publisher.id) === String(filters.publisherId) ? 'selected' : '' }}>{{ publisher.name }}</option>
    @endeach
  </select>
  <select name="type" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
    <option value="">Todos los tipos</option>
    <option value="physical" {{ filters.type === 'physical' ? 'selected' : '' }}>Fisico</option>
    <option value="digital" {{ filters.type === 'digital' ? 'selected' : '' }}>Digital</option>
    <option value="audiobook" {{ filters.type === 'audiobook' ? 'selected' : '' }}>Audiolibro</option>
  </select>
  <div class="flex gap-2">
    <select name="availability" class="focus-ring min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
      <option value="">Stock</option>
      <option value="available" {{ filters.availability === 'available' ? 'selected' : '' }}>Disponible</option>
      <option value="unavailable" {{ filters.availability === 'unavailable' ? 'selected' : '' }}>Agotado</option>
    </select>
    <button class="focus-ring rounded-md bg-slate-900 px-4 py-2 text-sm font-black text-white dark:bg-white dark:text-slate-950">Filtrar</button>
  </div>
</form>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  @each((book) in books)
    <article class="rounded-md border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950">
      <div class="flex gap-4">
        <img src="{{ book.coverImage || '/images/covers/cover-1.svg' }}" alt="" class="h-32 w-24 rounded-md object-cover" />
        <div class="min-w-0 flex-1">
          <div class="mb-2 flex flex-wrap gap-2">
            <span class="badge {{ book.availableUnits > 0 ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200' : 'bg-rose-50 text-rose-700 dark:bg-rose-500/15 dark:text-rose-200' }}">{{ book.availableUnits > 0 ? 'Disponible' : 'Agotado' }}</span>
            <span class="badge bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200">{{ book.type }}</span>
          </div>
          <h3 class="line-clamp-2 font-black">{{ book.title }}</h3>
          <p class="mt-1 text-sm text-slate-500">{{ book.author }}</p>
          <p class="mt-2 text-xs font-bold text-slate-500">{{ book.category.name }} - {{ book.publisher.name }}</p>
          <p class="mt-2 text-sm"><strong>{{ book.availableUnits }}</strong> de {{ book.totalUnits }} unidades</p>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        @if(authUser.role.name === 'Estudiante')
          <form method="POST" action="/student/books/{{ book.id }}/request">
            {{ csrfField() }}
            <button class="focus-ring rounded-md bg-teal-600 px-3 py-2 text-sm font-black text-white hover:bg-teal-700 disabled:opacity-50" {{ book.availableUnits <= 0 ? 'disabled' : '' }}>Solicitar</button>
          </form>
        @else
          <a href="/books/{{ book.id }}/edit" class="focus-ring rounded-md border border-slate-300 px-3 py-2 text-sm font-bold hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">Editar</a>
          @if(authUser.role.name === 'Administrador')
            <form method="POST" action="/books/{{ book.id }}">
              {{ csrfField() }}
              <input type="hidden" name="_method" value="DELETE" />
              <button class="focus-ring rounded-md border border-rose-200 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-50 dark:border-rose-900 dark:hover:bg-rose-500/10">Eliminar</button>
            </form>
          @endif
        @endif
      </div>
    </article>
  @endeach
</section>

<div class="mt-6 flex items-center justify-between rounded-md border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950">
  <a href="{{ books.getPreviousPageUrl() || '#' }}" class="rounded-md px-3 py-2 text-sm font-bold {{ books.getPreviousPageUrl() ? 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900' : 'pointer-events-none text-slate-400' }}">Anterior</a>
  <span class="text-sm font-bold text-slate-500">Pagina {{ books.currentPage }} de {{ books.lastPage }}</span>
  <a href="{{ books.getNextPageUrl() || '#' }}" class="rounded-md px-3 py-2 text-sm font-bold {{ books.getNextPageUrl() ? 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900' : 'pointer-events-none text-slate-400' }}">Siguiente</a>
</div>

@include('partials/page_end')
